{
  "schema_version": "1.0.0",
  "metadata_only": true,
  "skill": {
    "name": "mcm",
    "invocation": "$mcm",
    "entrypoint": ".agents/skills/mcm/SKILL.md",
    "embedded": true,
    "external_install_required": false
  },
  "profiles": {
    "problem-analysis": {
      "mode": "problem-analysis",
      "purpose": "从题目动词、对象、约束、依赖和交付物识别真正要回答的问题。",
      "references": [
        "references/problem-typing.md",
        "references/contest-answer-shapes.md"
      ]
    },
    "data-analysis": {
      "mode": "data-analysis",
      "purpose": "识别粒度、主键、观测机制、代理标签、泄漏和会改变答案的数据风险。",
      "references": [
        "references/data-inspection.md",
        "references/contest-answer-shapes.md"
      ]
    },
    "model-construction": {
      "mode": "model-construction",
      "purpose": "让模型处理本题的真实困难，并把输出连接到题目要求的答案形状。",
      "references": [
        "references/model-selection.md",
        "references/contest-answer-shapes.md"
      ]
    },
    "validation": {
      "mode": "validation",
      "purpose": "审查模型、证据和答案之间的断点，并验证真正可能改变结论的因素。",
      "references": [
        "references/validation.md",
        "references/contest-answer-shapes.md"
      ]
    },
    "figure-evidence": {
      "mode": "figure-evidence",
      "purpose": "先确定图表要证明的判断，再决定图型、数据和正文位置。",
      "references": [
        "references/plotting.md",
        "references/award-reader-model.md"
      ]
    },
    "paper-material": {
      "mode": "paper-material",
      "purpose": "把已授权事实组织成主答案、关键证据、题间接口与正文/附录取舍。",
      "references": [
        "references/paper-writing.md",
        "references/contest-answer-shapes.md",
        "assets/paper-template/paper-design-lenses.md"
      ]
    },
    "submission-draft": {
      "mode": "submission-draft",
      "purpose": "把稳定证据写成评委可快速理解、核验和比较的正式竞赛论文。",
      "references": [
        "references/paper-writing.md",
        "references/award-reader-model.md",
        "references/distill/writing-playbook.md",
        "assets/paper-template/abstract-stress-test.md",
        "references/competition-revision-lenses.md"
      ]
    },
    "judge-review": {
      "mode": "judge-review",
      "purpose": "沿评委阅读路径发现主答案缺失、模型错配、证据断裂和限制放置错误。",
      "references": [
        "references/judge-review-playbook.md",
        "references/award-reader-model.md",
        "references/contest-answer-shapes.md"
      ]
    },
    "prose-revision": {
      "mode": "prose-revision",
      "purpose": "在不改变数学事实的前提下修正对象、因果强度、比较口径和行动含义。",
      "references": [
        "references/competition-revision-lenses.md",
        "references/award-reader-model.md"
      ]
    },
    "blind-review": {
      "mode": "blind-review",
      "activation": "forbidden_until_explicit_override",
      "purpose": "保护独立盲审；盲审落盘前不加载 mcm 或国奖蒸馏，第二遍由 Leader 显式切换到 judge-review。",
      "references": []
    }
  },
  "bindings": {
    "leader": {"profile": "problem-analysis"},
    "role": {
      "default": "problem-analysis",
      "overrides": {
        "data-forensics": "data-analysis",
        "formulation-analyst": "model-construction",
        "route-proposer": "model-construction",
        "route-proposer-response": "model-construction",
        "trap-hunter": "validation",
        "cross-examiner": "validation",
        "route-critic": "validation",
        "original-judgment-review": "validation",
        "probe-designer": "validation",
        "fresh-context-reviewer": "validation"
      }
    },
    "data_leader": {"profile": "data-analysis"},
    "data_role": {"default": "data-analysis", "overrides": {"data-risk-reviewer": "validation", "data-repro-validator": "validation", "data-interface-reviewer": "validation"}},
    "model_leader": {"profile": "model-construction"},
    "model_role": {"default": "model-construction", "overrides": {"structural-challenger": "validation", "build-result-diagnostician": "validation"}},
    "validation_leader": {"profile": "validation"},
    "validation_role": {"default": "validation", "overrides": {}},
    "figure_leader": {"profile": "figure-evidence"},
    "figure_role": {"default": "figure-evidence", "overrides": {"figure-evidence-auditor": "validation"}},
    "paper_prep_leader": {"profile": "paper-material"},
    "paper_prep_role": {"default": "paper-material", "overrides": {"chapter-evidence-auditor": "validation", "competition-manuscript-reviewer": "blind-review"}},
    "paper_writing_leader": {"profile": "submission-draft"},
    "paper_writing_role": {"default": "submission-draft", "overrides": {"full-paper-fact-auditor": "validation", "competition-expression-reviewer": "judge-review", "full-paper-coherence-reviewer": "judge-review", "ai-prose-auditor": "prose-revision"}},
    "final_delivery_leader": {"profile": "judge-review"},
    "final_delivery_role": {"default": null, "overrides": {"answer-relevance-reviewer": "judge-review", "prose-engineering-style-auditor": "prose-revision", "delivery-evidence-auditor": "validation", "end-to-end-consistency-auditor": "validation"}},
    "literature_leader": {"profile": null},
    "literature_role": {"default": null, "overrides": {}},
    "formal_figure_leader": {"profile": "figure-evidence"},
    "formal_figure_role": {"default": "figure-evidence", "overrides": {"figure-portfolio-reviewer": "judge-review"}}
  },
  "snapshot_files": [
    ".agents/skills/mcm/SKILL.md",
    ".agents/skills/mcm/references/problem-typing.md",
    ".agents/skills/mcm/references/data-inspection.md",
    ".agents/skills/mcm/references/model-selection.md",
    ".agents/skills/mcm/references/validation.md",
    ".agents/skills/mcm/references/plotting.md",
    ".agents/skills/mcm/references/paper-writing.md",
    ".agents/skills/mcm/references/contest-answer-shapes.md",
    ".agents/skills/mcm/references/award-reader-model.md",
    ".agents/skills/mcm/references/judge-review-playbook.md",
    ".agents/skills/mcm/references/competition-revision-lenses.md",
    ".agents/skills/mcm/references/distill/writing-playbook.md",
    ".agents/skills/mcm/assets/paper-template/paper-design-lenses.md",
    ".agents/skills/mcm/assets/paper-template/abstract-stress-test.md"
  ]
}
